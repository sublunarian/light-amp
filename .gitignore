# Release signing — never commit a key you publish with. The dev keystore that
# ships in Light's repo (sdk/keys/lightsdk-dev.jks) is fine for side-loading
# your own builds and wrong for anything public: everyone building a tool has it.
release.keystore
release.jks
keystore.properties

# Staged release APKs — these belong in GitHub Releases, not the repo.
dist/
