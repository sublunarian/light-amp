+    /** Set the system media volume from a 0..1 fraction. */
+    fun setSystemVolume(fraction: Float) {
+        val min = audioManager.getStreamMinVolume(AudioManager.STREAM_MUSIC)
+        val max = audioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC)
+        val range = max - min
+        if (range <= 0) return
+        val target = min + (fraction.coerceIn(0f, 1f) * range).roundToInt()
+        audioManager.setStreamVolume(AudioManager.STREAM_MUSIC, target.coerceIn(min, max), 0)
+        updateDeviceVolume()
+    }
+
+    private fun updateDeviceVolume() {
+        val min = audioManager.getStreamMinVolume(AudioManager.STREAM_MUSIC)
+        val max = audioManager.getStreamMaxVolume(AudioManager.STREAM_MUSIC)
+        val range = max - min
+        if (range <= 0) return
+        _deviceVolume.value =
+            ((audioManager.getStreamVolume(AudioManager.STREAM_MUSIC) - min).toFloat() / range)
+                .coerceIn(0f, 1f)
+    }
