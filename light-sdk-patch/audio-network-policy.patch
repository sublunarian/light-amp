+package com.thelightphone.sdk.audio
+
+import java.io.FileNotFoundException
+import kotlin.test.Test
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+class LightAudioNetworkPolicyTest {
+    @Test
+    fun inPhoneSchemesNeverAsk() {
+        for (scheme in listOf(null, "", "file", "FILE", "asset", "content", "rawresource", "android.resource", "data")) {
+            assertFalse(isRemoteScheme(scheme), "scheme $scheme should not count as remote")
+        }
+    }
+
+    @Test
+    fun anythingElseIsANetworkFetch() {
+        for (scheme in listOf("http", "https", "HTTPS", "rtsp", "ftp", "udp")) {
+            assertTrue(isRemoteScheme(scheme), "scheme $scheme should count as remote")
+        }
+    }
+
+    @Test
+    fun refusalIsFinalToThePlayer() {
+        // The default load-error policy retries most IOExceptions for seconds;
+        // a FileNotFoundException it reports at once. A rule is not worth retrying.
+        assertTrue(LightAudioNetworkBlockedException() is FileNotFoundException)
+    }
+
+    @Test
+    fun policyAllowsByDefault() {
+        assertTrue(LightAudioNetworkPolicy.allowsNetwork())
+    }
+}
